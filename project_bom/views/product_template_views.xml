<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//field[@name='categ_id']" position="after">-->
<!--                <field name="product_type_id"/>-->
<!--            </xpath>-->
            <xpath expr="//notebook/page[@name='general_information']" position="after">
                <page string="Project BOM data" name="project_bom_data" invisible="product_variant_count &gt; 1">
                    <group>
                        <group string="Other data">
                            <field name="short_description"/>
                            <field name="component_type_id"/>
                        </group>
                        <separator string="Technical data" invisible="not component_type_id"/>
                        <div class="d-flex" invisible="not component_type_id">
                            <field name="component_properties"
                                   nolabel="1"
                                   columns="2"
                                   hideKanbanOption="0"
                                   invisible="not component_type_id"/>
                        </div>
<!--                        <group string="Technical data" name="component_data" invisible="not component_type_id">-->
<!--                            <field name="component_properties" nolabel="1" hideKanbanOption="0"/>-->
<!--                            <field name="component_package"/>-->
