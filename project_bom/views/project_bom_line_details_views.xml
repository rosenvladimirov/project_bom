<odoo>
    <data>
        <record id="view_project_bom_line_details_tree" model="ir.ui.view">
            <field name="name">project.bom.line.details.tree</field>
            <field name="model">project.bom.line.details</field>
            <field name="arch" type="xml">
                <tree string="Project EuroPlacer" editable="top">
                    <field name="sequence" widget="handle"/>
                    <field name="project_bom_id" column_invisible="not context.get('show_project_bom_id')"/>
                    <field name="project_bom_line_id" column_invisible="1"/>
                    <field name="designator"/>
                    <field name="final_product_tmpl_id" string="Used in product template" readonly="0"/>
                    <field name="final_product_id" string="Used in product variant" readonly="0"/>
                    <field name="used_in_operation"/>
                    <field name="default_code"/>
                    <field name="description"/>
                    <field name="domain_short_description" invisible="1"/>
                    <field name="short_description" readonly="0"/>
                    <field name="product_id" domain="domain_short_description"/>
                    <field name="hw_option" domain="[('is_kits', '=', True)]"/>

                    <field name="possible_bom_product_template_attribute_value_ids" invisible="1"/>
                    <field name="bom_product_template_attribute_value_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           groups="product.group_product_variant"/>

                    <field name="x_coordinate" optional="hide"/>
                    <field name="y_coordinate" optional="hide"/>
                    <field name="theta" optional="hide"/>
                    <field name="pattern_reference" optional="hide"/>
                    <field name="pattern_call" optional="hide"/>
                    <field name="fiducial_mark" optional="hide"/>
                    <field name="rejection_mark" optional="hide"/>
                    <field name="component_test" optional="hide"/>
                    <field name="optimization_mode" optional="hide"/>
                    <field name="auto_adaptive_sequencing" optional="hide"/>
                    <field name="stacking_board_number" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="view_project_bom_line_details_form" model="ir.ui.view">
            <field name="name">project.bom.line.details.form</field>
            <field name="model">project.bom.line.details</field>
            <field name="arch" type="xml">
                <form string="Project EuroPlacer">
                    <sheet>
                        <field name="project_bom_line_id" invisible="1"/>
                        <field name="project_bom_id" invisible="not context.get('show_project_bom_id')"/>
                        <field name="domain_short_description" invisible="1"/>
                        <group>
                            <group name="final_product" string="Final product">
                                <field name="final_product_tmpl_id" string="Used in product template" readonly="0"/>
                                <field name="final_product_id" string="Used in product variant" readonly="0"/>
                            </group>
                            <group name="components" string="Component">
                                <field name="default_code"/>
                                <field name="description"/>
                                <field name="short_description"/>
                                <field name="product_id" domain="domain_short_description"/>
                                <field name="hw_option" domain="[('is_kits', '=', True)]"/>
                                <field name="used_in_operation"/>
                                <field name="possible_bom_product_template_attribute_value_ids" invisible="1"/>
                                <field name="bom_product_template_attribute_value_ids" widget="many2many_tags" options="{'no_create': True}" groups="product.group_product_variant"/>
                            </group>
                            <group string="CAD data" name="cad">
                                <field name="designator"/>
                                <field name="x_coordinate"/>
                                <field name="y_coordinate"/>
                                <field name="theta"/>
                                <field name="pattern_reference"/>
                                <field name="pattern_call"/>
                                <field name="fiducial_mark"/>
                                <field name="rejection_mark"/>
                            </group>
                            <group string="EuroPlacer data" name="euro_placer">
                                <field name="component_test"/>
                                <field name="optimization_mode"/>
                                <field name="auto_adaptive_sequencing"/>
                                <field name="stacking_board_number"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_project_bom_line_details" model="ir.actions.act_window">
            <field name="name">Project Bill of Materials - Line Details</field>
            <field name="res_model">project.bom.line.details</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="project_bom.view_project_bom_line_details_tree"/>
            <field name="context">{'show_project_bom_id': True}</field>
        </record>

        <record id="action_project_sub_bom_line_details" model="ir.actions.act_window">
            <field name="name">Project Bill of Materials - Line Details</field>
            <field name="res_model">project.bom.line.details</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="project_bom.view_project_bom_line_details_tree"/>
            <field name="context">{'show_project_bom_id': False}</field>
        </record>

        <menuitem id="menu_project_bom_line_details"
                  name="Component Line details"
                  parent="project_bom.menu_project_mrp_bom_menu"
                  action="project_bom.action_project_bom_line_details"
                  sequence="2"/>
    </data>
</odoo>
