<odoo>
    <data>
        <record id="view_project_mrp_bom_line_version_tree" model="ir.ui.view">
            <field name="name">project.mrp.bom.line.version.tree</field>
            <field name="model">project.mrp.bom.line.version</field>
            <field name="arch" type="xml">
                <tree string="Project BOM line version" editable="top">
                    <field name="version"/>
                    <field name="product_id"/>
                    <field name="product_tmpl_id"/>
                    <field name="company_id"/>
                    <field name="product_qty"/>
                    <field name="product_uom_id"/>
                    <field name="product_uom_category_id"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>