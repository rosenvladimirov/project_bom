<odoo>
    <data>
        <record id="view_project_bom_line_details_import_wizard_form" model="ir.ui.view">
            <field name="name">project.bom.line.details.import.wizard.form</field>
            <field name="model">project.bom.line.details.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import BOM Line Details">
                    <field name="validated" invisible="1"/>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="product_id"/>
                            <field name="semi_product_tmpl_id" can_write="0" can_create="0"/>
                            <field name="semi_product_id" can_write="0" can_create="0"/>
                        </group>
                        <group>
                            <field name="data_file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Uploaded data" invisible="not line_details"/>
                    <field name="line_details" nolabel="1" invisible="not line_details" can_create="0">
                        <tree string="Project BOM Line Details Import Data"
                              decoration-danger="not is_valid"
                              decoration-success="is_valid" editable="bottom">
                            <field name="is_valid" column_invisible="1"/>
                            <field name="qty" readonly="1" force_save="1"/>
                            <field name="designator" readonly="1" force_save="1"/>
                            <field name="default_code" readonly="1" force_save="1"/>
                            <field name="description" readonly="1" force_save="1"/>
                            <field name="short_description" readonly="1" force_save="1"/>
                            <field name="product_id" readonly="1" force_save="1"/>
                            <field name="short_description_option" readonly="1" force_save="1"/>
                            <field name="hw_option" can_create="0" can_write="0" domain="[('is_kits', '=', True)]"/>
                            <field name="error_message" readonly="1" force_save="1"/>
                        </tree>
                    </field>
                    <footer>
                        <button string="Upload"
                                type="object"
                                name="action_upload"
                                class="btn-primary"
                                invisible="validated"/>
                        <button string="Import"
                                type="object"
                                name="action_import"
                                class="btn-primary"
                                invisible="not validated"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_custom_import_wizard" model="ir.actions.act_window">
            <field name="name">Import BOM Line Details</field>
            <field name="res_model">project.bom.line.details.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_project_bom_line_details_import_wizard_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>