<odoo>
    <data>
        <record id="view_project_bom_line_details_import_wizard_form" model="ir.ui.view">
            <field name="name">project.bom.line.details.import.wizard.form</field>
            <field name="model">project.bom.line.details.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import BOM Line Details">
                    <field name="validated" invisible="1"/>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="data_file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Uploaded data" invisible="not line_details"/>
                    <field name="line_details" nolabel="1" invisible="not line_details" readonly="1" force_save="1">
                        <tree string="Project BOM Line Details Import Data"
                              decoration-danger="not is_valid"
                              decoration-success="is_valid">
                            <field name="is_valid" column_invisible="1"/>
                            <field name="qty"/>
                            <field name="designator"/>
                            <field name="default_code"/>
                            <field name="description"/>
                            <field name="short_description"/>
                            <field name="product_id"/>
                            <field name="error_message"/>
                        </tree>
                    </field>
                    <footer>
                        <button string="Upload"
                                type="object"
                                name="action_upload"
                                class="btn-primary"
                                invisible="validated"/>
                        <button string="Import"
                                type="object"
                                name="action_import"
                                class="btn-primary"
                                invisible="not validated"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_custom_import_wizard" model="ir.actions.act_window">
            <field name="name">Import BOM Line Details</field>
            <field name="res_model">project.bom.line.details.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_project_bom_line_details_import_wizard_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>